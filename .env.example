JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_EXPIRES_IN_MINUTES=12506

DATABASE_URL=
DIRECT_URL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

RESEND_API_KEY=
RESEND_FROM_EMAIL=
PASSWORD_RESET_TOKEN_EXPIRES_MINUTES=5

NEXT_PUBLIC_APP_URL="http://localhost:3000"

SUPER_ADMIN_EMAIL=

# Development only: fixed phone OTP. Production always generates a random code.
OTP_STATIC_CODE=

# Required for /api/cron/escalate (send as "Authorization: Bearer <secret>"); calls are rejected when unset.
CRON_SECRET=

# Optional: database used by `npm run test:integration` (must contain "_test" in its name).
TEST_DATABASE_URL="postgresql://localhost:5432/smart_hospital_test"

# Hospital / chain identity shown on patient documents and used as the UHID prefix (e.g. SHDS-00000042).
NEXT_PUBLIC_HOSPITAL_NAME="Smart Hospital"
UHID_PREFIX="SHDS"
